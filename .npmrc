auto-install-peers=false
strict-peer-dependencies=false
# Flat node_modules — required for React Native / Expo native builds to resolve
# babel-preset-expo and autolink native modules correctly in this pnpm monorepo.
node-linker=hoisted
# Allow the lockfile to be updated when package.json changes (e.g. dependency
# version fixes). Without this, pnpm defaults to frozen-lockfile in CI and would
# either fail or install stale versions when the lockfile lags package.json.
frozen-lockfile=false
