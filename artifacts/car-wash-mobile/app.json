{
  "expo": {
    "name": "CarCleanPro",
    "slug": "shani-garg",
    "owner": "shanigarg26s-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "car-wash-mobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/d4b8d786-3cf7-4a02-acbf-d9405f07ce48"
    },
    "extra": {
      "eas": {
        "projectId": "d4b8d786-3cf7-4a02-acbf-d9405f07ce48"
      }
    },
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "CarCleanPro needs your location to match you with nearby car cleaning bookings.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "CarCleanPro needs your location to receive bookings even while the app is in the background.",
        "UIBackgroundModes": ["location", "fetch", "remote-notification"]
      }
    },
    "android": {
      "package": "com.shanigarg26.carcleanpro",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "CarCleanPro needs your location to match you with nearby car cleaning bookings.",
          "locationAlwaysAndWhenInUsePermission": "CarCleanPro needs your location in the background to receive bookings when the app is closed.",
          "locationAlwaysPermission": "CarCleanPro needs your location in the background to receive bookings when the app is closed.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
